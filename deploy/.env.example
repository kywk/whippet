# sh deploy/init-local.sh creates deploy/.env with random secrets and local paths.
WHIPPET_PROJECT_NAME=whippet-m1
WHIPPET_RUNNER_PROJECT_NAME=whippet-m1-runner
WHIPPET_CONTROL_NETWORK=whippet-m1-control
WEB_PORT=18080
SERVER_PORT=18081
POSTGRES_DB=whippet
POSTGRES_USER=whippet
# Use URL-safe hex; the password is interpolated into DATABASE_URL.
POSTGRES_PASSWORD=replace-with-a-random-hex-password
MANAGER_TOKEN=replace-with-a-long-random-token
# The local overlay uses http://server:8080 on the shared Docker network.
# For another runner host, set a reachable private HTTP(S) origin here.
SERVER_URL=http://server:8080
MANAGER_ID=local-runner
WORKER_IMAGE=whippet-worker:m1
# Manager and Docker daemon must agree on the host path for bind mounts.
WORK_DIR=/absolute/path/to/whippet/deploy/.local/runner
# init-local.sh detects the current Docker context's Unix socket (Desktop/OrbStack).
DOCKER_SOCKET_PATH=/var/run/docker.sock
