# Copy to deploy/.env.ai (ignored); keep this example free of credentials.
# The existing Worker image must be rebuilt once to include dist/ai/*.
WORKER_IMAGE=whippet-worker:m1
WHIPPET_AI_ENABLED=false
WHIPPET_AI_BASE_URL=https://opencode.ai/inference/go/openai/v1
WHIPPET_AI_MODEL=muse-spark-1.3-contributor
WHIPPET_AI_REASONING_EFFORT=xhigh
OPENCODE_API_KEY=
# session is a caller-owned --session=<conversation-id>, never a random default.
